CREATE TABLE BudgetEntity (
id TEXT NOT NULL PRIMARY KEY,
categoryId TEXT NOT NULL,
limitAmount REAL NOT NULL,
period TEXT NOT NULL DEFAULT 'MONTHLY',
isDirty INTEGER NOT NULL DEFAULT 1,
userId TEXT NOT NULL,
deletedAt TEXT,
serverUpdatedAt TEXT
);

selectAll:
SELECT * FROM BudgetEntity WHERE userId = :userId AND deletedAt IS NULL;

selectDirty:
SELECT * FROM BudgetEntity WHERE isDirty = 1 AND userId = :userId;

selectManifest:
SELECT id, serverUpdatedAt, isDirty FROM BudgetEntity WHERE userId = :userId;

insertRemote:
INSERT OR IGNORE INTO BudgetEntity(id, categoryId, limitAmount, period, isDirty, userId, deletedAt, serverUpdatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

applyRemote:
UPDATE BudgetEntity SET categoryId = :categoryId, limitAmount = :limitAmount, period = :period, serverUpdatedAt = :serverUpdatedAt, isDirty = 0
WHERE id = :id AND isDirty = 0;

deleteCleanById:
DELETE FROM BudgetEntity WHERE id = :id AND isDirty = 0;

budgetWithSpending:
SELECT b.*, COALESCE(SUM(t.amount), 0) AS spent
FROM BudgetEntity b
LEFT JOIN TransactionEntity t ON t.categoryId = b.categoryId
    AND t.type = 'EXPENSE'
    AND t.date LIKE :monthPrefix || '%'
    AND t.userId = b.userId
    AND t.deletedAt IS NULL
WHERE b.userId = :userId AND b.deletedAt IS NULL
GROUP BY b.id;

insert:
INSERT OR REPLACE INTO BudgetEntity(id, categoryId, limitAmount, period, isDirty, userId, deletedAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

markClean:
UPDATE BudgetEntity SET isDirty = 0 WHERE id = :id;

markDeleted:
UPDATE BudgetEntity SET deletedAt = :deletedAt, isDirty = 1 WHERE id = :id;

purgeTombstones:
DELETE FROM BudgetEntity WHERE deletedAt IS NOT NULL AND isDirty = 0;
