CREATE TABLE CategoryEntity (
    id       TEXT    NOT NULL PRIMARY KEY,
    name     TEXT    NOT NULL,
    emoji    TEXT    NOT NULL,
    colorHex TEXT    NOT NULL DEFAULT '#00C896',
    isCustom INTEGER NOT NULL DEFAULT 0,   -- 0 = default, 1 = user-created
    userId   TEXT,                          -- NULL for default categories
    sortOrder INTEGER NOT NULL DEFAULT 0,
    updatedAt TEXT NOT NULL DEFAULT '',     -- last local modification
    serverUpdatedAt TEXT,                   -- server updated_at last confirmed by pull/push
    isDirty  INTEGER NOT NULL DEFAULT 0,    -- 0 = in sync, 1 = pending push
    deletedAt TEXT                          -- tombstone for delete propagation
);

-- Seed default categories (insert once on first launch; never synced — their ids
-- are hardcoded and identical on every device, so they need no remote rows)
INSERT OR IGNORE INTO CategoryEntity(id, name, emoji, colorHex, isCustom, userId, sortOrder)
VALUES
    ('cat_food',        'Food & Dining',  '🍔', '#FF6B6B', 0, NULL, 0),
    ('cat_transport',   'Transport',      '🚕', '#4ECDC4', 0, NULL, 1),
    ('cat_shopping',    'Shopping',       '🛍', '#45B7D1', 0, NULL, 2),
    ('cat_health',      'Health',         '💊', '#96CEB4', 0, NULL, 3),
    ('cat_bills',       'Bills',          '⚡', '#FFEAA7', 0, NULL, 4),
    ('cat_housing',     'Housing',        '🏠', '#DDA0DD', 0, NULL, 5),
    ('cat_dining',      'Fine Dining',    '🍽', '#F0E68C', 0, NULL, 6),
    ('cat_entertain',   'Entertainment',  '🎬', '#98FB98', 0, NULL, 7),
    ('cat_savings',     'Savings',        '💰', '#87CEEB', 0, NULL, 8),
    ('cat_income',      'Income',         '💼', '#00C896', 0, NULL, 9);

-- Queries
selectAll:
SELECT *
FROM   CategoryEntity
WHERE  (userId IS NULL OR userId = :userId)
    AND deletedAt IS NULL
ORDER BY sortOrder ASC, name ASC;

selectById:
SELECT *
FROM   CategoryEntity
WHERE  id = :id;

selectDefaults:
SELECT *
FROM   CategoryEntity
WHERE  userId IS NULL
ORDER BY sortOrder ASC;

selectCustomForUser:
SELECT *
FROM   CategoryEntity
WHERE  userId = :userId AND deletedAt IS NULL
ORDER BY name ASC;

insertCustom:
INSERT INTO CategoryEntity(id, name, emoji, colorHex, isCustom, userId, sortOrder, updatedAt, isDirty)
VALUES (?, ?, ?, ?, 1, ?, ?, ?, ?);

insertRemote:
INSERT OR IGNORE INTO CategoryEntity(id, name, emoji, colorHex, isCustom, userId, sortOrder, serverUpdatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

applyRemote:
UPDATE CategoryEntity
SET name = :name, emoji = :emoji, colorHex = :colorHex, sortOrder = :sortOrder, serverUpdatedAt = :serverUpdatedAt, isDirty = 0
WHERE id = :id AND isDirty = 0;

selectDirty:
SELECT * FROM CategoryEntity WHERE isDirty = 1 AND userId = :userId;

selectManifest:
SELECT id, serverUpdatedAt, isDirty FROM CategoryEntity WHERE userId = :userId;

markClean:
UPDATE CategoryEntity SET isDirty = 0 WHERE id = :id;

markDeleted:
UPDATE CategoryEntity SET deletedAt = :deletedAt, isDirty = 1
WHERE id = :id AND isCustom = 1;  -- prevent deleting default categories

purgeTombstones:
DELETE FROM CategoryEntity WHERE deletedAt IS NOT NULL AND isDirty = 0;

deleteCleanById:
DELETE FROM CategoryEntity WHERE id = :id AND isDirty = 0;

-- Referential-integrity guards: a category still referenced by live rows must not
-- be tombstoned, or synced transactions/budgets would point at nothing on other devices.
isReferencedByTransaction:
SELECT EXISTS(SELECT 1 FROM TransactionEntity WHERE categoryId = :id AND deletedAt IS NULL LIMIT 1);

isReferencedByBudget:
SELECT EXISTS(SELECT 1 FROM BudgetEntity WHERE categoryId = :id AND deletedAt IS NULL LIMIT 1);
